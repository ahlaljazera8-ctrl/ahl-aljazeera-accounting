// DRAFT ONLY — not deployed, not tested in the Firebase Emulator.
// Derived from /workspace/accounting/docs/data-model.md §6 (which has pseudo-rules only, no .rules file)
// plus decisions: site may create client payments; site reads expense entries + its OWN entries;
// site may reverse only its own entries; owner may reverse any non-reversal entry; each original reversed at most once.
//
// "Once only" design: a reversal's document id is deterministic: rev_<originalId>.
//  - create requires entryId == 'rev_' + reversesEntryId, so a second reversal of the same original targets
//    the SAME document; it already exists, so the write is an update, and there is no `allow update` => refused.
//  - This needs no query/counter (rules can't query), costs one exists()/get() call, and is race-free:
//    two offline devices reversing the same entry both write rev_<id>; the server accepts only the first create.
//  - Normal entries must NOT start with 'rev_' so they can't squat a reversal id.
//  Caveat: offline, Firestore applies the 2nd write locally first; the server then rejects it and the client
//  rolls it back (app must ignore that rejection quietly, as in data-model.md §7).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isOwner()  { return signedIn() && me().role == 'owner' && me().active == true; }
    function isSite()   { return signedIn() && me().role == 'site'  && me().active == true; }
    function assigned(pid) { return pid in me().get('assignedProjectIds', []); }
    function entryPath(id) { return /databases/$(database)/documents/ledgerEntries/$(id); }

    match /ledgerEntries/{entryId} {
      function d() { return request.resource.data; }
      function typeOk() {
        return (d().direction == 'expense' && d().entryType in ['expense','materials','labour','subcontractor'])
            || (d().direction == 'income'  && d().entryType == 'clientPayment');
      }
      function baseOk() {
        return d().id == entryId
          && d().createdBy == request.auth.uid
          && d().createdAtServer == request.time
          && d().amount is int && d().amount > 0
          && d().currency == 'IQD'
          && d().isReversal is bool
          && typeOk()
          && exists(/databases/$(database)/documents/projects/$(d().projectId))
          && (isOwner() || assigned(d().projectId));
      }
      function normalOk() {
        return d().isReversal == false
          && !entryId.matches('rev_.*')
          && !('reversesEntryId' in d()) && !('reversalReason' in d());
      }
      function reversalOk() {
        let orig = get(entryPath(d().reversesEntryId)).data;
        return d().isReversal == true
          && entryId == 'rev_' + d().reversesEntryId          // deterministic id => at most once
          && exists(entryPath(d().reversesEntryId))
          && orig.isReversal == false                          // can't reverse a reversal
          && orig.projectId == d().projectId && orig.direction == d().direction
          && orig.entryType == d().entryType && orig.amount == d().amount
          && d().reversalReason is string && d().reversalReason.size() > 0
          && (isOwner() || (isSite() && orig.createdBy == request.auth.uid));
      }
      allow create: if (isOwner() || isSite()) && baseOk() && (normalOk() || reversalOk());
      // Rules are not filters: the site app must query (direction == 'expense') OR (createdBy == uid) separately.
      allow read: if isOwner()
        || (isSite() && assigned(resource.data.projectId)
            && (resource.data.direction == 'expense' || resource.data.createdBy == request.auth.uid));
      // no update, no delete => refused (append-only; also what makes rev_<id> once-only)
    }

    match /projects/{projectId} {
      allow create: if isOwner();
      allow read:   if isOwner() || (isSite() && assigned(projectId));
      allow update: if isOwner();   // status only — still an open question in the doc
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if isOwner();
    }
  }
}
