{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["public/**/*.js", "scripts/**/*.js", "tests/**/*.js", "types/**/*.d.ts"],
  "exclude": ["public/sw.js", "node_modules"]
}
