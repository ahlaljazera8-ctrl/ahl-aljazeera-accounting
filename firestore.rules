// Emulator-tested. Not deployed.
// Spark allowlist: a uid can do nothing until an owner writes users/{uid}.
// MAX_AMOUNT_IQD is the ledger ceiling (10,000,000,000 IQD).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function allowlisted() { return signedIn() && exists(userPath(request.auth.uid)); }
    function isOwner() { return allowlisted() && me().role == 'owner' && me().active == true; }
    function isSite() { return allowlisted() && me().role == 'site' && me().active == true; }
    function assigned(pid) { return pid in me().get('assignedProjectIds', []); }
    function entryPath(id) { return /databases/$(database)/documents/ledgerEntries/$(id); }
    function projectPath(id) { return /databases/$(database)/documents/projects/$(id); }
    function MAX_AMOUNT_IQD() { return 10000000000; }
    function idOk(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$'); }
    function idListOk(xs) {
      return xs is list && xs.size() <= 20;
    }
    function entryDateOk(s) {
      return s is string
        && s.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && s >= '2000-01-01'
        && s <= '2100-12-31'
        && !s.matches('^[0-9]{4}-02-3[01]$')
        && !s.matches('^[0-9]{4}-(04|06|09|11)-31$');
    }
    function projectOpen(pid) {
      return idOk(pid) && exists(projectPath(pid)) && get(projectPath(pid)).data.status == 'active';
    }

    match /ledgerEntries/{entryId} {
      function d() { return request.resource.data; }
      function optString(name, max) {
        return !(name in d()) || (d()[name] is string && d()[name].size() <= max);
      }
      // Optional payee. Stored trimmed, at most 100 characters.
      function partyNameOk() {
        return !('partyName' in d())
          || (d().partyName is string
              && d().partyName.size() <= 100
              && d().partyName == d().partyName.trim());
      }
      // Optional copy of the writer's displayName (max 60). Checked against
      // users/{auth.uid} so site users need no read access to other user docs.
      function createdByNameOk() {
        return !('createdByName' in d())
          || (d().createdByName is string
              && d().createdByName.size() <= 60
              && d().createdByName == me().displayName);
      }
      function shapeOk() {
        return d().keys().hasOnly(['id', 'projectId', 'direction', 'entryType', 'amount', 'currency', 'entryDate', 'description', 'partyName', 'isReversal', 'reversesEntryId', 'reversalReason', 'createdAtDevice', 'createdAtServer', 'createdBy', 'createdByName', 'deviceId'])
          && d().id == entryId
          && idOk(entryId)
          && idOk(d().projectId)
          && d().createdBy == request.auth.uid
          && d().createdBy is string
          && d().createdAtServer == request.time
          && d().amount is int
          && d().amount > 0
          && d().amount <= MAX_AMOUNT_IQD()
          && d().currency == 'IQD'
          && entryDateOk(d().entryDate)
          && d().isReversal is bool
          && d().createdAtDevice is int
          && d().deviceId is string
          && d().deviceId.size() > 0
          && d().deviceId.size() <= 128
          && optString('description', 500)
          && partyNameOk()
          && createdByNameOk();
      }
      function typeOk() {
        return (d().direction == 'expense' && d().entryType in ['expense', 'materials', 'labour', 'subcontractor'])
            || (d().direction == 'income' && d().entryType == 'clientPayment');
      }
      function baseOk() {
        return shapeOk() && typeOk() && projectOpen(d().projectId)
          && (isOwner() || (isSite() && assigned(d().projectId)));
      }
      function normalOk() {
        return d().isReversal == false
          && !entryId.matches('^rev_.*')
          && !('reversesEntryId' in d())
          && !('reversalReason' in d());
      }
      function reversalOk() {
        let orig = get(entryPath(d().reversesEntryId)).data;
        return d().isReversal == true
          && idOk(d().reversesEntryId)
          && entryId == 'rev_' + d().reversesEntryId
          && exists(entryPath(d().reversesEntryId))
          && orig.isReversal == false
          && orig.projectId == d().projectId
          && orig.direction == d().direction
          && orig.entryType == d().entryType
          && orig.amount == d().amount
          && d().reversalReason is string
          && d().reversalReason.size() > 0
          && d().reversalReason.size() <= 500
          && (isOwner() || (isSite() && orig.createdBy == request.auth.uid));
      }

      allow create: if (isOwner() || isSite()) && baseOk() && (normalOk() || reversalOk());
      // F11: assignment is required for every site read, including the author's own rows.
      // Rules are not a filter. The site client queries each assigned project.
      allow read: if isOwner();
      allow read: if isSite() && assigned(resource.data.projectId) && resource.data.createdBy == request.auth.uid;
      allow read: if isSite() && assigned(resource.data.projectId) && resource.data.direction == 'expense';
    }

    match /projects/{projectId} {
      function p() { return request.resource.data; }
      function optString(name, max) {
        return !(name in p()) || (p()[name] is string && p()[name].size() <= max);
      }
      function projectShape() {
        return p().keys().hasOnly(['id', 'name', 'clientName', 'location', 'contractAmount', 'currency', 'status', 'createdAtDevice', 'createdAtServer', 'createdBy', 'deviceId'])
          && p().id == projectId
          && idOk(projectId)
          && p().name is string && p().name.size() > 0 && p().name.size() <= 200
          && p().clientName is string && p().clientName.size() <= 200
          && optString('location', 200)
          && (!('contractAmount' in p()) || (p().contractAmount is int && p().contractAmount >= 0 && p().contractAmount <= MAX_AMOUNT_IQD()))
          && p().currency == 'IQD'
          && p().status in ['active', 'closed']
          && p().createdAtDevice is int
          && p().createdAtServer is timestamp
          && idOk(p().createdBy)
          && p().deviceId is string && p().deviceId.size() > 0 && p().deviceId.size() <= 128;
      }
      allow create: if isOwner() && projectShape() && p().createdBy == request.auth.uid;
      allow read: if isOwner() || (isSite() && assigned(projectId));
      allow update: if isOwner() && projectShape()
        && p().id == resource.data.id
        && p().createdBy == resource.data.createdBy
        && p().createdAtDevice == resource.data.createdAtDevice;
    }

    match /users/{uid} {
      function u() { return request.resource.data; }
      function userShape() {
        return u().keys().hasOnly(['displayName', 'email', 'role', 'active', 'assignedProjectIds', 'createdAtServer', 'createdBy'])
          && u().displayName is string && u().displayName.size() > 0 && u().displayName.size() <= 80
          && u().email is string && u().email.size() > 3 && u().email.size() <= 200 && u().email.matches('.*@.*[.].*')
          && u().role in ['owner', 'site']
          && u().active is bool
          && idListOk(u().assignedProjectIds)
          && u().createdAtServer is timestamp
          && idOk(u().createdBy);
      }
      allow read: if allowlisted() && (request.auth.uid == uid || isOwner());
      allow create: if isOwner() && idOk(uid) && userShape() && u().createdBy == request.auth.uid;
      allow update: if isOwner() && idOk(uid) && userShape() && u().createdBy == resource.data.createdBy;
    }
  }
}
