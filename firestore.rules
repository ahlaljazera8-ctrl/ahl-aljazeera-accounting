// Emulator-tested. Live on ahl-aljazeera-accounting (deployed manually).
// Spark allowlist: a uid can do nothing until an owner writes users/{uid}.
// MAX_AMOUNT_IQD is the ledger ceiling (10,000,000,000 IQD).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function allowlisted() { return signedIn() && exists(userPath(request.auth.uid)); }
    function isOwner() { return allowlisted() && me().role == 'owner' && me().active == true; }
    function isSite() { return allowlisted() && me().role == 'site' && me().active == true; }
    function assigned(pid) { return pid in me().get('assignedProjectIds', []); }
    function entryPath(id) { return /databases/$(database)/documents/ledgerEntries/$(id); }
    function projectPath(id) { return /databases/$(database)/documents/projects/$(id); }
    function foremanPath(id) { return /databases/$(database)/documents/foremen/$(id); }
    function foremanMovePath(id) { return /databases/$(database)/documents/foremanMoves/$(id); }
    function MAX_AMOUNT_IQD() { return 10000000000; }
    function idOk(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$'); }
    // Each item uses idOk. Rules have no loop, so the twenty slots are spelled out.
    function idListOk(xs) {
      return xs is list && xs.size() <= 20
        && (xs.size() < 1 || idOk(xs[0]))
        && (xs.size() < 2 || idOk(xs[1]))
        && (xs.size() < 3 || idOk(xs[2]))
        && (xs.size() < 4 || idOk(xs[3]))
        && (xs.size() < 5 || idOk(xs[4]))
        && (xs.size() < 6 || idOk(xs[5]))
        && (xs.size() < 7 || idOk(xs[6]))
        && (xs.size() < 8 || idOk(xs[7]))
        && (xs.size() < 9 || idOk(xs[8]))
        && (xs.size() < 10 || idOk(xs[9]))
        && (xs.size() < 11 || idOk(xs[10]))
        && (xs.size() < 12 || idOk(xs[11]))
        && (xs.size() < 13 || idOk(xs[12]))
        && (xs.size() < 14 || idOk(xs[13]))
        && (xs.size() < 15 || idOk(xs[14]))
        && (xs.size() < 16 || idOk(xs[15]))
        && (xs.size() < 17 || idOk(xs[16]))
        && (xs.size() < 18 || idOk(xs[17]))
        && (xs.size() < 19 || idOk(xs[18]))
        && (xs.size() < 20 || idOk(xs[19]));
    }
    function entryDateOk(s) {
      return s is string
        && s.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && s >= '2000-01-01'
        && s <= '2100-12-31'
        && !s.matches('^[0-9]{4}-02-3[01]$')
        && !s.matches('^[0-9]{4}-(04|06|09|11)-31$');
    }
    function projectOpen(pid) {
      return idOk(pid) && exists(projectPath(pid)) && get(projectPath(pid)).data.status == 'active';
    }
    // A child delete is allowed only when that one project document is gone
    // by the end of the request. Deleting a single ledger row of a project
    // that is still there is denied. existsAfter sees the rest of the batch.
    function projectGone(pid) {
      return idOk(pid) && !existsAfter(projectPath(pid));
    }

    match /ledgerEntries/{entryId} {
      function d() { return request.resource.data; }
      function optString(name, max) {
        return !(name in d()) || (d()[name] is string && d()[name].size() <= max);
      }
      // Optional payee. Stored trimmed, at most 100 characters.
      function partyNameOk() {
        return !('partyName' in d())
          || (d().partyName is string
              && d().partyName.size() <= 100
              && d().partyName == d().partyName.trim());
      }
      // Optional copy of the writer's displayName (max 80, same as userShape).
      // Checked against users/{auth.uid} so site users need no read access to other user docs.
      function createdByNameOk() {
        return !('createdByName' in d())
          || (d().createdByName is string
              && d().createdByName.size() <= 80
              && d().createdByName == me().displayName);
      }
      function shapeOk() {
        return d().keys().hasOnly(['id', 'projectId', 'direction', 'entryType', 'amount', 'currency', 'entryDate', 'description', 'partyName', 'subcontractId', 'foremanId', 'isReversal', 'reversesEntryId', 'reversalReason', 'createdAtDevice', 'createdAtServer', 'createdBy', 'createdByName', 'deviceId'])
          && d().id == entryId
          && idOk(entryId)
          && idOk(d().projectId)
          && d().createdBy == request.auth.uid
          && d().createdBy is string
          && d().createdAtServer == request.time
          && d().amount is int
          && d().amount > 0
          && d().amount <= MAX_AMOUNT_IQD()
          && d().currency == 'IQD'
          && entryDateOk(d().entryDate)
          && d().isReversal is bool
          && d().createdAtDevice is int
          && d().deviceId is string
          && d().deviceId.size() > 0
          && d().deviceId.size() <= 128
          && optString('description', 500)
          && partyNameOk()
          && createdByNameOk();
      }
      function linkedSubcontract() {
        return idOk(d().subcontractId)
          && exists(/databases/$(database)/documents/subcontracts/$(d().subcontractId))
          && get(/databases/$(database)/documents/subcontracts/$(d().subcontractId)).data.projectId == d().projectId;
      }
      // A missing subcontractId is an old owner row. A site «مقاول» payment must name a subcontract on the assigned project.
      function linkOk() {
        return !('subcontractId' in d())
          ? (d().entryType != 'subcontractor' || isOwner())
          : (d().entryType == 'subcontractor'
              && linkedSubcontract()
              && (isOwner() || (isSite() && assigned(d().projectId))));
      }
      function typeOk() {
        return (d().direction == 'expense' && d().entryType in ['expense', 'materials', 'labour', 'subcontractor'])
            || (d().direction == 'income' && d().entryType == 'clientPayment');
      }
      function baseOk() {
        return shapeOk() && typeOk() && projectOpen(d().projectId)
          && (isOwner() || (isSite() && assigned(d().projectId)));
      }
      function normalOk() {
        return d().isReversal == false
          && !entryId.matches('^rev_.*')
          && !('reversesEntryId' in d())
          && !('reversalReason' in d());
      }
      function reversalOk() {
        let orig = get(entryPath(d().reversesEntryId)).data;
        return d().isReversal == true
          && idOk(d().reversesEntryId)
          && entryId == 'rev_' + d().reversesEntryId
          && exists(entryPath(d().reversesEntryId))
          && orig.isReversal == false
          && orig.projectId == d().projectId
          && orig.direction == d().direction
          && orig.entryType == d().entryType
          && orig.amount == d().amount
          && d().reversalReason is string
          && d().reversalReason.size() > 0
          && d().reversalReason.size() <= 500
          && (isOwner() || (isSite() && orig.createdBy == request.auth.uid))
          && (('foremanId' in orig) ? (d().foremanId == orig.foremanId) : !('foremanId' in d()));
      }
      function foremanOk() {
        return !('foremanId' in d())
          || (idOk(d().foremanId)
              && exists(foremanPath(d().foremanId))
              && d().direction == 'expense'
              && isOwner());
      }

      allow create: if (isOwner() || isSite()) && baseOk() && (normalOk() || reversalOk()) && linkOk() && foremanOk();
      allow delete: if isOwner() && projectGone(resource.data.projectId);
      // F11: assignment is required for every site read, including the author's own rows.
      // Rules are not a filter. The site client queries each assigned project.
      allow read: if isOwner();
      allow read: if isSite() && assigned(resource.data.projectId) && resource.data.createdBy == request.auth.uid;
      allow read: if isSite() && assigned(resource.data.projectId) && resource.data.direction == 'expense';
    }

    // Money is projectFinance/{projectId}. A project write that includes
    // contractAmount is denied. A document saved before the split can still
    // hold that field until the owner saves the project again: rules cannot
    // remove a field on read, and a full owner rewrite is what drops it.
    match /projects/{projectId} {
      function p() { return request.resource.data; }
      function optString(name, max) {
        return !(name in p()) || (p()[name] is string && p()[name].size() <= max);
      }
      function projectShape() {
        return p().keys().hasOnly(['id', 'name', 'clientName', 'location', 'currency', 'status', 'createdAtDevice', 'createdAtServer', 'createdBy', 'deviceId'])
          && p().id == projectId
          && idOk(projectId)
          && !('contractAmount' in p())
          && p().name is string && p().name.size() > 0 && p().name.size() <= 200
          && p().clientName is string && p().clientName.size() <= 200
          && optString('location', 200)
          && p().currency == 'IQD'
          && p().status in ['active', 'closed', 'archived']
          && p().createdAtDevice is int
          && p().createdAtServer is timestamp
          && idOk(p().createdBy)
          && p().deviceId is string && p().deviceId.size() > 0 && p().deviceId.size() <= 128;
      }
      allow create: if isOwner() && projectShape() && p().createdBy == request.auth.uid;
      allow read: if isOwner() || (isSite() && assigned(projectId));
      allow update: if isOwner() && projectShape()
        && p().id == resource.data.id
        && p().createdBy == resource.data.createdBy
        && p().createdAtDevice == resource.data.createdAtDevice;
      // Any status. Archived and closed projects are included.
      allow delete: if isOwner() && idOk(projectId);
    }

    match /users/{uid} {
      function u() { return request.resource.data; }
      function userShape() {
        return u().keys().hasOnly(['displayName', 'email', 'role', 'active', 'assignedProjectIds', 'createdAtServer', 'createdBy'])
          && u().displayName is string && u().displayName.size() > 0 && u().displayName.size() <= 80
          && u().email is string && u().email.size() > 3 && u().email.size() <= 200 && u().email.matches('.*@.*[.].*')
          && u().role in ['owner', 'site']
          && u().active is bool
          && idListOk(u().assignedProjectIds)
          && u().createdAtServer is timestamp
          && idOk(u().createdBy);
      }
      allow read: if allowlisted() && (request.auth.uid == uid || isOwner());
      allow create: if isOwner() && idOk(uid) && userShape() && u().createdBy == request.auth.uid;
      allow update: if isOwner() && idOk(uid) && userShape() && u().createdBy == resource.data.createdBy;
    }

    match /projectFinance/{projectId} {
      function f() { return request.resource.data; }
      function financeShape() {
        return f().keys().hasOnly(['contractAmount'])
          && f().contractAmount is int
          && f().contractAmount >= 0
          && f().contractAmount <= MAX_AMOUNT_IQD();
      }
      allow read: if isOwner() && idOk(projectId);
      allow create, update: if isOwner() && idOk(projectId) && financeShape();
      allow delete: if isOwner() && projectGone(projectId);
    }

    // The name is readable by the project. The agreed amount is subcontractTerms.
    match /subcontracts/{id} {
      function s() { return request.resource.data; }
      function nameShape() {
        return s().keys().hasOnly(['id', 'projectId', 'name', 'work', 'agreedOn', 'createdAtServer', 'createdBy'])
          && s().id == id
          && idOk(id)
          && idOk(s().projectId)
          && projectOpen(s().projectId)
          && s().name is string && s().name.size() > 0 && s().name.size() <= 100
          && s().work is string && s().work.size() <= 500
          && entryDateOk(s().agreedOn)
          && s().createdAtServer == request.time
          && s().createdBy == request.auth.uid;
      }
      allow read: if isOwner() || (isSite() && assigned(resource.data.projectId));
      allow create: if isOwner() && nameShape();
      allow update: if false;
      allow delete: if isOwner() && projectGone(resource.data.projectId);
    }

    match /subcontractTerms/{id} {
      function t() { return request.resource.data; }
      function termsShape() {
        return idOk(id)
          && exists(/databases/$(database)/documents/subcontracts/$(id))
          && t().keys().hasOnly(['originalAmount'])
          && t().originalAmount is int
          && t().originalAmount > 0
          && t().originalAmount <= MAX_AMOUNT_IQD();
      }
      allow read: if isOwner() && idOk(id);
      allow create: if isOwner() && termsShape();
      allow update: if false;
      // Terms have no projectId. The subcontract document carries it. Once that
      // subcontract is already gone, the terms row is an orphan of a project
      // delete and the owner may remove it.
      allow delete: if isOwner() && idOk(id) && (
        exists(/databases/$(database)/documents/subcontracts/$(id))
          ? projectGone(get(/databases/$(database)/documents/subcontracts/$(id)).data.projectId)
          : true
      );
    }

    match /subcontractAmendments/{amendmentId} {
      function a() { return request.resource.data; }
      function amendmentShape() {
        return a().keys().hasOnly(['id', 'subcontractId', 'projectId', 'amount', 'date', 'note', 'createdAtServer', 'createdBy'])
          && a().id == amendmentId
          && idOk(amendmentId)
          && idOk(a().subcontractId)
          && idOk(a().projectId)
          && projectOpen(a().projectId)
          && exists(/databases/$(database)/documents/subcontracts/$(a().subcontractId))
          && get(/databases/$(database)/documents/subcontracts/$(a().subcontractId)).data.projectId == a().projectId
          && a().amount is int
          && a().amount > 0
          && a().amount <= MAX_AMOUNT_IQD()
          && entryDateOk(a().date)
          && a().note is string && a().note.size() > 0 && a().note.size() <= 200
          && a().createdAtServer == request.time
          && a().createdBy == request.auth.uid;
      }
      allow read: if isOwner();
      allow create: if isOwner() && amendmentShape();
      allow update: if false;
      allow delete: if isOwner() && projectGone(resource.data.projectId);
    }

    // Owner-only foreman names. projectId is a default for the expense form, not a hard link.
    match /foremen/{id} {
      function f() { return request.resource.data; }
      function optNote() {
        return !('note' in f()) || (f().note is string && f().note.size() <= 200);
      }
      function foremanShape() {
        return f().keys().hasOnly(['id', 'name', 'note', 'projectId', 'createdAtServer', 'createdBy'])
          && f().id == id
          && idOk(id)
          && f().name is string && f().name.size() > 0 && f().name.size() <= 100
          && optNote()
          && (!('projectId' in f()) || idOk(f().projectId))
          && f().createdAtServer == request.time
          && f().createdBy == request.auth.uid;
      }
      allow read: if isOwner();
      allow create: if isOwner() && foremanShape();
      allow update: if false;
      allow delete: if false;
    }

    // Owner-only foreman movements. A correction is a new rev_ row.
    match /foremanMoves/{id} {
      function m() { return request.resource.data; }
      function moveShape() {
        return m().keys().hasOnly(['id', 'foremanId', 'kind', 'amount', 'date', 'note', 'isReversal', 'reversesMoveId', 'reversalReason', 'createdAtDevice', 'createdAtServer', 'createdBy', 'deviceId'])
          && m().id == id
          && idOk(id)
          && idOk(m().foremanId)
          && exists(foremanPath(m().foremanId))
          && m().kind in ['advance', 'settle', 'return']
          && m().amount is int
          && m().amount > 0
          && m().amount <= MAX_AMOUNT_IQD()
          && entryDateOk(m().date)
          && m().note is string && m().note.size() <= 200
          && m().isReversal is bool
          && m().createdAtDevice is int
          && m().deviceId is string && m().deviceId.size() > 0 && m().deviceId.size() <= 128
          && m().createdAtServer == request.time
          && m().createdBy == request.auth.uid;
      }
      function moveNormalOk() {
        return m().isReversal == false
          && !id.matches('^rev_.*')
          && !('reversesMoveId' in m())
          && !('reversalReason' in m());
      }
      function moveReversalOk() {
        let orig = get(foremanMovePath(m().reversesMoveId)).data;
        return m().isReversal == true
          && idOk(m().reversesMoveId)
          && id == 'rev_' + m().reversesMoveId
          && exists(foremanMovePath(m().reversesMoveId))
          && orig.isReversal == false
          && orig.foremanId == m().foremanId
          && orig.kind == m().kind
          && orig.amount == m().amount
          && m().reversalReason is string
          && m().reversalReason.size() > 0
          && m().reversalReason.size() <= 500;
      }
      allow read: if isOwner();
      allow create: if isOwner() && moveShape() && (moveNormalOk() || moveReversalOk());
      allow update: if false;
      allow delete: if false;
    }

    // Contractor PR D. Create-only parties, agreements, accountTxns, statementApprovals.
    // Each create leaf's first line is one user get. No isOwner(), me(), allowlisted(), or projectOpen().
    // accountTxnCreate and agreementsCreate do not get or exists. They call one leaf.

    function ownerOk(user) {
      return user.data.role == 'owner' && user.data.active == true;
    }
    function projectActive(project) {
      return project.data.status == 'active';
    }
    function uuidOk(value) {
      return value is string && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }
    function isSlotId(value) {
      return value is string && value.matches('^000[0-9a-f]{32}[1-9]$');
    }
    function supCount(value) {
      return value.matches('^sup_sup_sup_sup_sup_.*') ? 5
        : value.matches('^sup_sup_sup_sup_.*') ? 4
        : value.matches('^sup_sup_sup_.*') ? 3
        : value.matches('^sup_sup_.*') ? 2
        : value.matches('^sup_.*') ? 1
        : 0;
    }
    function bodyIdOk(value) {
      return uuidOk(value) || isSlotId(value) || (supCount(value) >= 1 && supCount(value) <= 4 && uuidOk(value.replace('sup_', '')));
    }
    function charGen(value, prefix) {
      return value == prefix + '1' ? '1'
        : value == prefix + '2' ? '2'
        : value == prefix + '3' ? '3'
        : value == prefix + '4' ? '4'
        : value == prefix + '5' ? '5'
        : value == prefix + '6' ? '6'
        : value == prefix + '7' ? '7'
        : value == prefix + '8' ? '8'
        : value == prefix + '9' ? '9'
        : '';
    }
    function prevChar(gen) {
      return gen == '2' ? '1'
        : gen == '3' ? '2'
        : gen == '4' ? '3'
        : gen == '5' ? '4'
        : gen == '6' ? '5'
        : gen == '7' ? '6'
        : gen == '8' ? '7'
        : gen == '9' ? '8'
        : '0';
    }
    function slotGen(value, agreementId) {
      return charGen(value, '000' + agreementId.replace('-', ''));
    }
    function methodKeys(method) {
      return method == 'lump' ? ['lumpAmount']
        : method == 'unit' ? ['unitRate', 'unitQty', 'unitName']
        : method == 'daily' ? ['dayRate']
        : method == 'milestone' ? ['milestoneAmount', 'milestoneMode']
        : [];
    }
    function agreementBase() {
      return ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId'];
    }
    // The emulator rejects list + list ("Unsupported operation error. Received: list + list").
    // agreementKeys(method) is agreementBase() + methodKeys(method).
    // reversalKeys(method) is that list plus ['reversesId', 'reversalReason'].
    function agreementKeys(method) {
      return method == 'lump'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'lumpAmount']
        : method == 'unit'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'unitRate', 'unitQty', 'unitName']
        : method == 'daily'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'dayRate']
        : method == 'milestone'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'milestoneAmount', 'milestoneMode']
        : ['id'];
    }
    function reversalKeys(method) {
      return method == 'lump'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'lumpAmount', 'reversesId', 'reversalReason']
        : method == 'unit'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'unitRate', 'unitQty', 'unitName', 'reversesId', 'reversalReason']
        : method == 'daily'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'dayRate', 'reversesId', 'reversalReason']
        : method == 'milestone'
        ? ['id', 'partyId', 'projectId', 'method', 'description', 'currency', 'createdBy', 'createdAtServer', 'deviceId', 'milestoneAmount', 'milestoneMode', 'reversesId', 'reversalReason']
        : ['id'];
    }
    // == on every key of the original's group. A missing key errors and is denied.
    function groupEquals(data, orig) {
      return orig.method == 'lump' ? data.lumpAmount == orig.lumpAmount
        : orig.method == 'unit' ? data.unitRate == orig.unitRate && data.unitQty == orig.unitQty && data.unitName == orig.unitName
        : orig.method == 'daily' ? data.dayRate == orig.dayRate
        : orig.method == 'milestone' ? data.milestoneAmount == orig.milestoneAmount && data.milestoneMode == orig.milestoneMode
        : false;
    }
    function methodFieldsOk(data) {
      return data.method == 'lump'
          ? (data.lumpAmount is int && data.lumpAmount >= 1 && data.lumpAmount <= MAX_AMOUNT_IQD())
        : data.method == 'unit'
          ? (data.unitRate is int && data.unitRate >= 1 && data.unitRate <= 100000000
            && data.unitQty is int && data.unitQty >= 1 && data.unitQty <= 1000000
            && data.unitName is string && data.unitName.size() >= 1 && data.unitName.size() <= 80
            && data.unitName == data.unitName.trim())
        : data.method == 'daily'
          ? (data.dayRate is int && data.dayRate >= 1 && data.dayRate <= 100000000)
        : data.method == 'milestone'
          ? (data.milestoneMode == 'amount'
            && data.milestoneAmount is int && data.milestoneAmount >= 1 && data.milestoneAmount <= MAX_AMOUNT_IQD())
        : false;
    }
    function headerOk(data, user) {
      return data.createdBy == request.auth.uid
        && data.createdAtServer == request.time
        && data.deviceId is string
        && data.deviceId.size() > 0
        && data.deviceId.size() <= 128
        && (!('createdByName' in data)
          || (data.createdByName is string
            && data.createdByName.size() >= 1
            && data.createdByName.size() <= 80
            && data.createdByName == user.data.displayName));
    }
    function rateOk(data) {
      return data.currency == 'IQD' && data.fxRate == 1;
    }
    function moneyOk(data) {
      return rateOk(data) && data.amount is int && data.amount >= 1 && data.amount <= MAX_AMOUNT_IQD();
    }
    function qtyOk(qty) {
      return qty is int && qty >= 1 && qty <= 100000000;
    }
    function optDate(data) {
      return !('txnDate' in data) || entryDateOk(data.txnDate);
    }
    function optDesc(data) {
      return !('description' in data) || (data.description is string && data.description.size() <= 500);
    }
    function prevRevwId(targetId, gen) {
      return gen == '1' ? 'revw_' + targetId
        : gen == '2' ? 'revw_' + targetId + '_1'
        : gen == '3' ? 'revw_' + targetId + '_2'
        : gen == '4' ? 'revw_' + targetId + '_3'
        : gen == '5' ? 'revw_' + targetId + '_4'
        : gen == '6' ? 'revw_' + targetId + '_5'
        : gen == '7' ? 'revw_' + targetId + '_6'
        : gen == '8' ? 'revw_' + targetId + '_7'
        : gen == '9' ? 'revw_' + targetId + '_8'
        : 'revw_' + targetId + '_0';
    }
    function purposeOk(purpose, ledger) {
      return ledger == 'labor' && (
        purpose == 'laborQty' || purpose == 'approveLabor' || purpose == 'advanceLabor'
        || purpose == 'payLabor' || purpose == 'returnAdvance' || purpose == 'refundLabor'
        || purpose == 'deduct' || purpose == 'approveDeduct' || purpose == 'settle');
    }
    function needsApproval(purpose) {
      return purpose == 'laborQty' || purpose == 'deduct';
    }
    function accountRead() {
