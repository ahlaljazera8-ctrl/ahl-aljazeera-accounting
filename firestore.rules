            && agreement.unitQty is int && agreement.unitQty >= 1 && agreement.unitQty <= 1000000
            && data.amount is int && data.amount >= 1 && data.amount <= MAX_AMOUNT_IQD()
            && data.qty * agreement.unitRate <= 10000000000000000
