          && noRej
          && noSup
          && d().partyId == body.data.partyId
          && d().projectId == body.data.projectId
          && d().ledger == body.data.ledger
          && d().currency == body.data.currency
          && d().fxRate == body.data.fxRate
          && rateOk(d());
      }
      /**
       * @returns {boolean}
       * Reads: 5. Denied when appr_ of the target is already stored.
       */
      function rejCreate() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let target = get(/databases/$(database)/documents/accountTxns/$(request.resource.data.targetId));
        let project = get(/databases/$(database)/documents/projects/$(target.data.projectId));
        let party = get(/databases/$(database)/documents/parties/$(target.data.partyId));
        let noAppr = !existsAfter(/databases/$(database)/documents/accountTxns/$('appr_' + request.resource.data.targetId));
        return ownerOk(user)
          && headerOk(d(), user)
          && projectActive(project)
          && party.data.name is string
          && idOk(id)
          && d().id == id
          && d().kind == 'rej'
          && id == 'rej_' + d().targetId
          && d().keys().hasOnly(['id', 'kind', 'targetId', 'createdBy', 'createdByName', 'createdAtServer', 'deviceId'])
          && !('amount' in d())
          && !('purpose' in d())
          && needsApproval(target.data.purpose)
          && target.data.kind in ['body', 'sup']
          && noAppr;
      }
      /**
       * @returns {boolean}
       * Reads: 3. user, the row named by reversesId, project. No separate party get.
       * agreementId presence matches the original. No extra get.
       */
      function revCreate() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let original = get(/databases/$(database)/documents/accountTxns/$(request.resource.data.reversesId));
        let project = get(/databases/$(database)/documents/projects/$(request.resource.data.projectId));
        return ownerOk(user)
          && headerOk(d(), user)
          && projectActive(project)
          && idOk(id)
          && d().id == id
          && d().kind == 'rev'
          && id == 'rev_' + d().reversesId
          && idOk(d().reversesId)
          && original.data.kind in ['body', 'sup', 'appr', 'stl', 'revw']
          && d().keys().hasOnly(['id', 'kind', 'purpose', 'ledger', 'projectId', 'partyId', 'agreementId', 'amount', 'currency', 'fxRate', 'reversesId', 'reversalReason', 'createdBy', 'createdByName', 'createdAtServer', 'deviceId'])
          && d().purpose == original.data.purpose
          && d().ledger == original.data.ledger
          && d().projectId == original.data.projectId
          && d().partyId == original.data.partyId
          && d().currency == original.data.currency
          && d().fxRate == original.data.fxRate
          && d().get('amount', null) == original.data.get('amount', null)
          && d().get('agreementId', null) == original.data.get('agreementId', null)
          && d().reversalReason is string
          && d().reversalReason.size() >= 1
          && d().reversalReason.size() <= 500
          && d().currency == 'IQD'
          && d().fxRate == 1;
      }
      /**
       * @returns {boolean}
       * First mark reads 3. A later mark also exists rev_ of the previous mark.
       */
      function revwCreate() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let cash = get(/databases/$(database)/documents/accountTxns/$(request.resource.data.targetId));
        let project = get(/databases/$(database)/documents/projects/$(request.resource.data.projectId));
        return ownerOk(user)
          && headerOk(d(), user)
          && projectActive(project)
          && idOk(id)
          && d().id == id
          && d().kind == 'revw'
          && !('amount' in d())
          && d().keys().hasOnly(['id', 'kind', 'purpose', 'ledger', 'projectId', 'partyId', 'currency', 'fxRate', 'targetId', 'createdBy', 'createdByName', 'createdAtServer', 'deviceId'])
          && cash.data.purpose in ['payLabor', 'advanceLabor', 'returnAdvance', 'refundLabor']
          && cash.data.kind == 'body'
          && d().purpose == cash.data.purpose
          && d().ledger == 'labor'
          && d().ledger == cash.data.ledger
          && d().partyId == cash.data.partyId
          && d().projectId == cash.data.projectId
          && d().currency == cash.data.currency
          && d().fxRate == cash.data.fxRate
          && rateOk(d())
          && (id == 'revw_' + d().targetId
            || (charGen(id, 'revw_' + d().targetId + '_') != ''
              && exists(/databases/$(database)/documents/accountTxns/$('rev_' + prevRevwId(d().targetId, charGen(id, 'revw_' + d().targetId + '_'))))));
      }
      /**
       * Dispatcher. No get and no exists. Exactly one leaf runs.
       * kind is read with in. purpose is read only when the key is present.
       */
      function accountTxnCreate() {
        return !('kind' in request.resource.data) ? false
          : request.resource.data.kind == 'rej' ? rejCreate()
          : request.resource.data.kind == 'rev' ? revCreate()
          : request.resource.data.kind == 'revw' ? revwCreate()
          : request.resource.data.kind == 'sup' ? supCreate()
          : request.resource.data.kind == 'stl' && 'purpose' in request.resource.data && request.resource.data.purpose == 'settle' ? laborStlCreate()
          : request.resource.data.kind == 'appr' && 'purpose' in request.resource.data && request.resource.data.purpose == 'approveLabor' ? approveLaborCreate()
          : request.resource.data.kind == 'appr' && 'purpose' in request.resource.data && request.resource.data.purpose == 'approveDeduct' ? approveDeductCreate()
          : request.resource.data.kind == 'body' && 'purpose' in request.resource.data && request.resource.data.purpose == 'laborQty' && isSlotId(id) ? slotBodyCreate()
          : request.resource.data.kind == 'body' && 'purpose' in request.resource.data && request.resource.data.purpose == 'laborQty' ? laborQtyCreate()
          : request.resource.data.kind == 'body' && 'purpose' in request.resource.data && (request.resource.data.purpose == 'payLabor' || request.resource.data.purpose == 'advanceLabor') ? cashBodyCreate()
          : request.resource.data.kind == 'body' && 'purpose' in request.resource.data && request.resource.data.purpose == 'returnAdvance' ? returnAdvanceCreate()
          : request.resource.data.kind == 'body' && 'purpose' in request.resource.data && request.resource.data.purpose == 'refundLabor' ? refundLaborCreate()
          : request.resource.data.kind == 'body' && 'purpose' in request.resource.data && request.resource.data.purpose == 'deduct' ? deductCreate()
          : false;
      }
      allow read: if accountRead();
      allow create: if accountTxnCreate();
      allow update, delete: if false;
    }

    match /statementApprovals/{id} {
      function d() { return request.resource.data; }
      function periodOk() {
        return (d().periodKind == 'week' || d().periodKind == 'month')
          && entryDateOk(d().periodStart)
          && entryDateOk(d().periodEnd)
          && d().periodStart <= d().periodEnd
          && d().createdBy == request.auth.uid
          && d().createdAtServer == request.time
          && uuidOk(id)
          && d().id == id
          && idOk(d().partyId);
      }
      /**
       * @returns {boolean}
       * Reads: 3. user, party, project. Used only when projectId is present.
       */
      function statementWithProjectCreate() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let party = get(/databases/$(database)/documents/parties/$(request.resource.data.partyId));
        let project = get(/databases/$(database)/documents/projects/$(request.resource.data.projectId));
        return ownerOk(user)
          && projectActive(project)
          && party.data.name is string
          && 'projectId' in d()
          && idOk(d().projectId)
          && d().keys().hasOnly(['id', 'partyId', 'projectId', 'periodKind', 'periodStart', 'periodEnd', 'createdBy', 'createdAtServer'])
          && periodOk();
      }
      /**
       * @returns {boolean}
       * Reads: 2. user, party. No project get. Consolidated: projectId is absent.
       */
      function statementConsolidatedCreate() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let party = get(/databases/$(database)/documents/parties/$(request.resource.data.partyId));
        return ownerOk(user)
          && party.data.name is string
          && !('projectId' in d())
          && d().keys().hasOnly(['id', 'partyId', 'periodKind', 'periodStart', 'periodEnd', 'createdBy', 'createdAtServer'])
          && periodOk();
      }
      function statementCreate() {
        return 'projectId' in request.resource.data ? statementWithProjectCreate() : statementConsolidatedCreate();
      }
      allow read: if accountRead();
      allow create: if statementCreate();
      allow update, delete: if false;
    }
  }
}
